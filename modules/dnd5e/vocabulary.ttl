dnd:rarity-artifact a skos:Concept ; skos:inScheme dnd:Rarities ; skos:notation "6" ; skos:prefLabel "artefacto"@es , "artifact"@en .

#################################################################
# Clases (12) / Classes (12)
#################################################################

dnd:class-barbarian a dnd:CharacterClass ;
    rdfs:label "Bárbaro"@es , "Barbarian"@en ;
    schema:description "Combatiente feroz que se apoya en su furia y su aguante."@es , "Fierce warrior relying on rage and toughness."@en ;
    dnd:hitDie 12 ; dnd:primaryAbility dnd:ability-str ;
    dnd:classSavingThrow dnd:ability-str , dnd:ability-con .

dnd:class-bard a dnd:CharacterClass ;
    rdfs:label "Bardo"@es , "Bard"@en ;
    schema:description "Artista cuya música y palabras tienen poder mágico."@es , "Performer whose music and words carry magical power."@en ;
    dnd:hitDie 8 ; dnd:primaryAbility dnd:ability-cha ; dnd:spellcastingAbility dnd:ability-cha ;
    dnd:classSavingThrow dnd:ability-dex , dnd:ability-cha .

dnd:class-cleric a dnd:CharacterClass ;
    rdfs:label "Clérigo"@es , "Cleric"@en ;
    schema:description "Sacerdote que canaliza el poder de una divinidad."@es , "Priest channelling the power of a deity."@en ;
    dnd:hitDie 8 ; dnd:primaryAbility dnd:ability-wis ; dnd:spellcastingAbility dnd:ability-wis ;
    dnd:classSavingThrow dnd:ability-wis , dnd:ability-cha .

dnd:class-druid a dnd:CharacterClass ;
    rdfs:label "Druida"@es , "Druid"@en ;
    schema:description "Guardián de la naturaleza capaz de adoptar formas animales."@es , "Guardian of nature able to take animal shapes."@en ;
