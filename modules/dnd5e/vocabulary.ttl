    dnd:classSavingThrow dnd:ability-int , dnd:ability-wis .

dnd:class-fighter a dnd:CharacterClass ;
    rdfs:label "Guerrero"@es , "Fighter"@en ;
    schema:description "Experto en armas y armaduras de todo tipo."@es , "Expert in all kinds of weapons and armor."@en ;
    dnd:hitDie 10 ; dnd:primaryAbility dnd:ability-str , dnd:ability-dex ;
    dnd:classSavingThrow dnd:ability-str , dnd:ability-con .

dnd:class-monk a dnd:CharacterClass ;
    rdfs:label "Monje"@es , "Monk"@en ;
    schema:description "Artista marcial que domina la energía interior (ki)."@es , "Martial artist mastering inner energy (ki)."@en ;
    dnd:hitDie 8 ; dnd:primaryAbility dnd:ability-dex , dnd:ability-wis ;
    dnd:classSavingThrow dnd:ability-str , dnd:ability-dex .

dnd:class-paladin a dnd:CharacterClass ;
    rdfs:label "Paladín"@es , "Paladin"@en ;
    schema:description "Guerrero sagrado ligado por un juramento."@es , "Holy warrior bound by an oath."@en ;
    dnd:hitDie 10 ; dnd:primaryAbility dnd:ability-str , dnd:ability-cha ; dnd:spellcastingAbility dnd:ability-cha ;
    dnd:classSavingThrow dnd:ability-wis , dnd:ability-cha .

dnd:class-ranger a dnd:CharacterClass ;
    rdfs:label "Explorador"@es , "Ranger"@en ;
    schema:description "Rastreador de las tierras salvajes y cazador de amenazas."@es , "Wilderness tracker and hunter of threats."@en ;
    dnd:hitDie 10 ; dnd:primaryAbility dnd:ability-dex , dnd:ability-wis ; dnd:spellcastingAbility dnd:ability-wis ;
    dnd:classSavingThrow dnd:ability-str , dnd:ability-dex .

dnd:class-rogue a dnd:CharacterClass ;
    rdfs:label "Pícaro"@es , "Rogue"@en ;
    schema:description "Especialista en sigilo, trampas y golpes certeros."@es , "Specialist in stealth, traps and precise strikes."@en ;
    dnd:hitDie 8 ; dnd:primaryAbility dnd:ability-dex ;
    dnd:classSavingThrow dnd:ability-dex , dnd:ability-int .

dnd:class-sorcerer a dnd:CharacterClass ;
    rdfs:label "Hechicero"@es , "Sorcerer"@en ;
    schema:description "Lanzador con magia innata, heredada o recibida."@es , "Caster with innate, inherited or gifted magic."@en ;
    dnd:hitDie 6 ; dnd:primaryAbility dnd:ability-cha ; dnd:spellcastingAbility dnd:ability-cha ;
    dnd:classSavingThrow dnd:ability-con , dnd:ability-cha .

dnd:class-warlock a dnd:CharacterClass ;
    rdfs:label "Brujo"@es , "Warlock"@en ;
    schema:description "Lanzador que obtiene su magia de un pacto con un ser poderoso."@es , "Caster drawing magic from a pact with a powerful being."@en ;
    dnd:hitDie 8 ; dnd:primaryAbility dnd:ability-cha ; dnd:spellcastingAbility dnd:ability-cha ;
    dnd:classSavingThrow dnd:ability-wis , dnd:ability-cha .

dnd:class-wizard a dnd:CharacterClass ;
    rdfs:label "Mago"@es , "Wizard"@en ;
    schema:description "Estudioso de la magia arcana que guarda sus conjuros en un libro."@es , "Scholar of arcane magic who keeps spells in a book."@en ;
