# Tipos de criatura / Creature types
#################################################################

dnd:type-aberration a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "aberración"@es , "aberration"@en .
dnd:type-beast a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "bestia"@es , "beast"@en .
dnd:type-celestial a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "celestial"@es , "celestial"@en .
dnd:type-construct a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "autómata"@es , "construct"@en .
dnd:type-dragon a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "dragón"@es , "dragon"@en .
dnd:type-elemental a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "elemental"@es , "elemental"@en .
dnd:type-fey a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "feérico"@es , "fey"@en .
dnd:type-fiend a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "infernal"@es , "fiend"@en .
dnd:type-giant a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "gigante"@es , "giant"@en .
dnd:type-humanoid a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "humanoide"@es , "humanoid"@en .
dnd:type-monstrosity a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "monstruosidad"@es , "monstrosity"@en .
dnd:type-ooze a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "cieno"@es , "ooze"@en .
dnd:type-plant a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "planta"@es , "plant"@en .
dnd:type-undead a skos:Concept ; skos:inScheme dnd:CreatureTypes ; skos:prefLabel "muerto viviente"@es , "undead"@en .

#################################################################
# Estados / Conditions
#################################################################

dnd:cond-blinded a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "cegado"@es , "blinded"@en ;
    skos:definition "No ve; sus ataques tienen desventaja y los ataques contra él, ventaja."@es , "Cannot see; its attacks have disadvantage and attacks against it have advantage."@en .
dnd:cond-charmed a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "hechizado"@es , "charmed"@en ;
    skos:definition "No puede dañar a quien le hechizó y este tiene ventaja al tratar con él."@es , "Cannot harm its charmer, who has advantage when dealing with it."@en .
dnd:cond-deafened a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "ensordecido"@es , "deafened"@en ;
    skos:definition "No oye nada."@es , "Cannot hear anything."@en .
dnd:cond-exhaustion a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "cansancio"@es , "exhaustion"@en ;
    skos:definition "Penalizaciones acumulativas en seis niveles (ver dnd:exhaustionLevel)."@es , "Cumulative penalties in six levels (see dnd:exhaustionLevel)."@en .
dnd:cond-frightened a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "asustado"@es , "frightened"@en ;
    skos:definition "Desventaja mientras vea la fuente de su miedo; no puede acercarse a ella."@es , "Disadvantage while it sees the source of its fear; cannot approach it."@en .
dnd:cond-grappled a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "agarrado"@es , "grappled"@en ;
    skos:definition "Su velocidad pasa a ser 0."@es , "Its speed becomes 0."@en .
dnd:cond-incapacitated a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "incapacitado"@es , "incapacitated"@en ;
    skos:definition "No puede realizar acciones ni reacciones."@es , "Cannot take actions or reactions."@en .
dnd:cond-invisible a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "invisible"@es , "invisible"@en ;
    skos:definition "No puede ser visto sin magia o sentidos especiales."@es , "Cannot be seen without magic or special senses."@en .
dnd:cond-paralyzed a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "paralizado"@es , "paralyzed"@en ;
    skos:definition "Incapacitado e inmóvil; los golpes cercanos son críticos."@es , "Incapacitated and unable to move; nearby hits are critical."@en .
dnd:cond-petrified a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "petrificado"@es , "petrified"@en ;
    skos:definition "Convertido en sustancia inanimada, como la piedra."@es , "Turned into an inanimate substance, such as stone."@en .
dnd:cond-poisoned a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "envenenado"@es , "poisoned"@en ;
    skos:definition "Desventaja en ataques y pruebas de característica."@es , "Disadvantage on attacks and ability checks."@en .
dnd:cond-prone a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "derribado"@es , "prone"@en ;
    skos:definition "Tumbado en el suelo; solo puede arrastrarse."@es , "Lying on the ground; can only crawl."@en .
dnd:cond-restrained a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "apresado"@es , "restrained"@en ;
    skos:definition "Inmovilizado; sus ataques y salvaciones de Destreza sufren."@es , "Held fast; its attacks and Dexterity saves suffer."@en .
dnd:cond-stunned a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "aturdido"@es , "stunned"@en ;
    skos:definition "Incapacitado y apenas puede hablar."@es , "Incapacitated and can barely speak."@en .
dnd:cond-unconscious a skos:Concept ; skos:inScheme dnd:Conditions ; skos:prefLabel "inconsciente"@es , "unconscious"@en ;
    skos:definition "Sin sentido: incapacitado, derribado y ajeno a su entorno."@es , "Senseless: incapacitated, prone and unaware of its surroundings."@en .

