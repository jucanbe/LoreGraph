#################################################################
# Características / Abilities
#################################################################

dnd:ability-str a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Fuerza"@es , "Strength"@en ; dnd:abbreviation "FUE / STR" ;
    skos:definition "Potencia física y atletismo."@es , "Physical power and athletics."@en .
dnd:ability-dex a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Destreza"@es , "Dexterity"@en ; dnd:abbreviation "DES / DEX" ;
    skos:definition "Agilidad, reflejos y equilibrio."@es , "Agility, reflexes and balance."@en .
dnd:ability-con a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Constitución"@es , "Constitution"@en ; dnd:abbreviation "CON / CON" ;
    skos:definition "Salud, vigor y resistencia."@es , "Health, vigour and endurance."@en .
dnd:ability-int a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Inteligencia"@es , "Intelligence"@en ; dnd:abbreviation "INT / INT" ;
    skos:definition "Razonamiento, memoria y saber."@es , "Reasoning, memory and learning."@en .
dnd:ability-wis a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Sabiduría"@es , "Wisdom"@en ; dnd:abbreviation "SAB / WIS" ;
    skos:definition "Percepción, intuición y sentido común."@es , "Perception, intuition and common sense."@en .
dnd:ability-cha a skos:Concept ; skos:inScheme dnd:Abilities ;
    skos:prefLabel "Carisma"@es , "Charisma"@en ; dnd:abbreviation "CAR / CHA" ;
    skos:definition "Presencia, persuasión y liderazgo."@es , "Presence, persuasion and leadership."@en .

#################################################################
# Habilidades (18) / Skills (18)
#################################################################

dnd:skill-acrobatics a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-dex ;
    skos:prefLabel "Acrobacias"@es , "Acrobatics"@en .
dnd:skill-animal-handling a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-wis ;
    skos:prefLabel "Trato con animales"@es , "Animal Handling"@en .
dnd:skill-arcana a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-int ;
    skos:prefLabel "Conocimiento arcano"@es , "Arcana"@en .
dnd:skill-athletics a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-str ;
    skos:prefLabel "Atletismo"@es , "Athletics"@en .
dnd:skill-deception a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-cha ;
    skos:prefLabel "Engaño"@es , "Deception"@en .
dnd:skill-history a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-int ;
    skos:prefLabel "Historia"@es , "History"@en .
dnd:skill-insight a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-wis ;
    skos:prefLabel "Perspicacia"@es , "Insight"@en .
dnd:skill-intimidation a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-cha ;
    skos:prefLabel "Intimidación"@es , "Intimidation"@en .
dnd:skill-investigation a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-int ;
    skos:prefLabel "Investigación"@es , "Investigation"@en .
dnd:skill-medicine a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-wis ;
    skos:prefLabel "Medicina"@es , "Medicine"@en .
dnd:skill-nature a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-int ;
    skos:prefLabel "Naturaleza"@es , "Nature"@en .
dnd:skill-perception a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-wis ;
    skos:prefLabel "Percepción"@es , "Perception"@en .
dnd:skill-performance a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-cha ;
    skos:prefLabel "Interpretación"@es , "Performance"@en .
dnd:skill-persuasion a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-cha ;
    skos:prefLabel "Persuasión"@es , "Persuasion"@en .
dnd:skill-religion a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-int ;
    skos:prefLabel "Religión"@es , "Religion"@en .
dnd:skill-sleight-of-hand a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-dex ;
    skos:prefLabel "Juego de manos"@es , "Sleight of Hand"@en .
dnd:skill-stealth a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-dex ;
    skos:prefLabel "Sigilo"@es , "Stealth"@en .
dnd:skill-survival a skos:Concept ; skos:inScheme dnd:Skills ; dnd:keyAbility dnd:ability-wis ;
    skos:prefLabel "Supervivencia"@es , "Survival"@en .

#################################################################
# Alineamientos / Alignments
#################################################################

dnd:align-lg a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "legal bueno"@es , "lawful good"@en ;
    skos:definition "Hace lo correcto dentro de un código o una ley."@es , "Does the right thing within a code or law."@en .
dnd:align-ng a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "neutral bueno"@es , "neutral good"@en ;
    skos:definition "Ayuda a los demás sin atarse a normas ni rebelarse contra ellas."@es , "Helps others without being bound by or rebelling against rules."@en .
dnd:align-cg a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "caótico bueno"@es , "chaotic good"@en ;
    skos:definition "Bondad guiada por la conciencia propia, no por la autoridad."@es , "Goodness guided by one's own conscience, not authority."@en .
dnd:align-ln a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "legal neutral"@es , "lawful neutral"@en ;
    skos:definition "El orden y la tradición por encima de todo."@es , "Order and tradition above all."@en .
dnd:align-n a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "neutral"@es , "neutral"@en ;
    skos:definition "Evita tomar partido en los grandes dilemas morales."@es , "Avoids taking sides in great moral dilemmas."@en .
dnd:align-cn a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "caótico neutral"@es , "chaotic neutral"@en ;
    skos:definition "Valora su libertad personal por encima de todo."@es , "Values personal freedom above everything."@en .
dnd:align-le a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "legal malvado"@es , "lawful evil"@en ;
    skos:definition "Usa el orden y las normas para dominar a otros."@es , "Uses order and rules to dominate others."@en .
dnd:align-ne a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "neutral malvado"@es , "neutral evil"@en ;
    skos:definition "Hace lo que le conviene sin remordimientos."@es , "Does whatever benefits it, without remorse."@en .
dnd:align-ce a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "caótico malvado"@es , "chaotic evil"@en ;
    skos:definition "Violencia arbitraria movida por la codicia o el odio."@es , "Arbitrary violence driven by greed or hatred."@en .
dnd:align-unaligned a skos:Concept ; skos:inScheme dnd:Alignments ;
    skos:prefLabel "sin alineamiento"@es , "unaligned"@en ;
    skos:definition "Criaturas sin juicio moral: bestias, cienos, autómatas."@es , "Creatures without moral judgement: beasts, oozes, automata."@en .

#################################################################
# Tamaños / Sizes
#################################################################

dnd:size-tiny a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "1" ;
    skos:prefLabel "Diminuto"@es , "Tiny"@en .
dnd:size-small a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "2" ;
    skos:prefLabel "Pequeño"@es , "Small"@en .
dnd:size-medium a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "3" ;
    skos:prefLabel "Mediano"@es , "Medium"@en .
dnd:size-large a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "4" ;
    skos:prefLabel "Grande"@es , "Large"@en .
dnd:size-huge a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "5" ;
    skos:prefLabel "Enorme"@es , "Huge"@en .
dnd:size-gargantuan a skos:Concept ; skos:inScheme dnd:Sizes ; skos:notation "6" ;
    skos:prefLabel "Gargantuesco"@es , "Gargantuan"@en .

