    dnd:size dnd:size-medium ; dnd:speed 30 .
dnd:species-high-elf a dnd:Species ; rdfs:label "Alto elfo"@es , "High Elf"@en ;
    dnd:subspeciesOf dnd:species-elf ; dnd:size dnd:size-medium ; dnd:speed 30 .
