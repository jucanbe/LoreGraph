    dnd:size dnd:size-medium ; dnd:speed 30 .
dnd:species-dragonborn a dnd:Species ; rdfs:label "Dracónido"@es , "Dragonborn"@en ;
    schema:description "Humanoides de linaje dragontino con aliento elemental."@es , "Humanoids of draconic lineage with an elemental breath."@en ;
    dnd:size dnd:size-medium ; dnd:speed 30 .
dnd:species-gnome a dnd:Species ; rdfs:label "Gnomo"@es , "Gnome"@en ;
