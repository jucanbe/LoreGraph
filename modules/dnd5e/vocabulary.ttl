#################################################################
# Escuelas de magia / Schools of magic
#################################################################

dnd:school-abjuration a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "abjuración"@es , "abjuration"@en ;
    skos:definition "Protección, bloqueo y destierro."@es , "Protection, warding and banishment."@en .
dnd:school-conjuration a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "conjuración"@es , "conjuration"@en ;
    skos:definition "Traer criaturas u objetos y teletransportarse."@es , "Summoning creatures or objects and teleporting."@en .
dnd:school-divination a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "adivinación"@es , "divination"@en ;
    skos:definition "Revelar información oculta."@es , "Revealing hidden information."@en .
dnd:school-enchantment a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "encantamiento"@es , "enchantment"@en ;
    skos:definition "Influir en la mente de otros."@es , "Influencing the minds of others."@en .
dnd:school-evocation a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "evocación"@es , "evocation"@en ;
    skos:definition "Manipular energía: fuego, rayos, luz, curación."@es , "Shaping energy: fire, lightning, light, healing."@en .
dnd:school-illusion a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "ilusionismo"@es , "illusion"@en ;
    skos:definition "Engañar a los sentidos."@es , "Deceiving the senses."@en .
dnd:school-necromancy a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "nigromancia"@es , "necromancy"@en ;
    skos:definition "Fuerzas de la vida y la muerte."@es , "Forces of life and death."@en .
dnd:school-transmutation a skos:Concept ; skos:inScheme dnd:SpellSchools ; skos:prefLabel "transmutación"@es , "transmutation"@en ;
    skos:definition "Cambiar las propiedades de criaturas y cosas."@es , "Changing the properties of creatures and things."@en .

