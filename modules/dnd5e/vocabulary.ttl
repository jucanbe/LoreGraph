    skos:prefLabel "marcial a distancia"@es , "martial ranged"@en .

dnd:armor-light a skos:Concept ; skos:inScheme dnd:ArmorCategories ; skos:prefLabel "ligera"@es , "light"@en .
dnd:armor-medium a skos:Concept ; skos:inScheme dnd:ArmorCategories ; skos:prefLabel "intermedia"@es , "medium"@en .
dnd:armor-heavy a skos:Concept ; skos:inScheme dnd:ArmorCategories ; skos:prefLabel "pesada"@es , "heavy"@en .
dnd:armor-shield a skos:Concept ; skos:inScheme dnd:ArmorCategories ; skos:prefLabel "escudo"@es , "shield"@en .

dnd:rarity-common a skos:Concept ; skos:inScheme dnd:Rarities ; skos:notation "1" ; skos:prefLabel "común"@es , "common"@en .
dnd:rarity-uncommon a skos:Concept ; skos:inScheme dnd:Rarities ; skos:notation "2" ; skos:prefLabel "poco común"@es , "uncommon"@en .
dnd:rarity-rare a skos:Concept ; skos:inScheme dnd:Rarities ; skos:notation "3" ; skos:prefLabel "raro"@es , "rare"@en .
