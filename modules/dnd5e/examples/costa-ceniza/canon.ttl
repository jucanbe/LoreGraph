#################################################################
# La Costa de Ceniza — campaña de ejemplo (ambientación original)
# Sistema: D&D 5.ª edición, solo contenido del SRD 5.1.
#################################################################

#################################################################
# Sesiones
#################################################################

:sesion-01 a rpg:Session ;
    rdfs:label "Sesión 1: El naufragio del Pez Plata" ;
    rpg:sessionNumber 1 ;
    rpg:sessionDate "2026-09-05"^^xsd:date ;
    rpg:inWorldDateLabel "3 de Brumal del año 1207 del Sello de Sal" ;
    rpg:sessionNotes "Los cuatro supervivientes del Pez Plata llegan a nado a las Islas de Ceniza. Rescatan la carga de sal, se refugian en los Túneles Verdes y la capitana Leonor los contrata a su regreso a Puerto Brasa." .

:sesion-02 a rpg:Session ;
    rdfs:label "Sesión 2: Sal y colmillos" ;
    rpg:sessionNumber 2 ;
    rpg:sessionDate "2026-09-19"^^xsd:date ;
    rpg:inWorldDateLabel "9 de Brumal del año 1207" ;
    rpg:sessionNotes "Los Colmillos de Basalto asaltan la caravana de la Cofradía en los Campos de Malpaís. Gruk hiere a Iria y huye. Sira y sus Gaviotas Negras aparecen al final para llevarse el mérito." .

:sesion-03 a rpg:Session ;
    rdfs:label "Sesión 3: Humo en la cumbre" ;
    rpg:sessionNumber 3 ;
    rpg:sessionDate "2026-10-03"^^xsd:date ;
    rpg:inWorldDateLabel "15 de Brumal del año 1207" ;
    rpg:sessionNotes "La Montaña del Fuego Dormido vuelve a humear. Nuño sueña con una voz de brasas que le ofrece un trato y acepta. En la Alcazaba, la alcaidesa Velasca niega cualquier peligro." .

#################################################################
# Jugadores
#################################################################

:jugadora-marta a rpg:Player ; rdfs:label "Marta" ;
    schema:description "Juega desde la primera sesión; le encantan los combates tácticos." .
:jugador-diego a rpg:Player ; rdfs:label "Diego" ;
    schema:description "Veterano de la mesa; lleva siempre al sanador del grupo." .
:jugadora-lucia a rpg:Player ; rdfs:label "Lucía" ;
    schema:description "Disfruta investigando los secretos del mundo." .
:jugador-andres a rpg:Player ; rdfs:label "Andrés" ;
    schema:description "Prefiere los personajes con pactos turbios y dilemas morales." .

#################################################################
# Personajes jugadores
#################################################################

