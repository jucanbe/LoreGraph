#################################################################
# PNJ criaturas (bloque de estadísticas del bestiario)
#################################################################

:calcinaria a rpg:NonPlayerCharacter , dnd:Creature ;
    rdfs:label "Calcinaria" ;
    skos:altLabel "la Brasa Durmiente" ;
    schema:description "Dragona roja joven que durmió veinte años en el corazón de la montaña tras la gran erupción. Ahora despierta, hambrienta de oro y de vasallos." ;
    rpg:inspiredBy wd:Q7559 ;
    rpg:vitalStatus rpg:vital-alive ;
    rpg:locatedIn :montana-fuego-dormido ;
    rpg:participatesIn :erupcion-fuego-dormido ;
    dnd:statBlock dnd:monster-young-red-dragon ;
    dnd:alignment dnd:align-ce ;
    dnd:currentHitPoints 178 ;
    rpg:appearsInSession :sesion-03 .

:toro-basalto a rpg:NonPlayerCharacter , dnd:Creature ;
    rdfs:label "El Toro de Basalto" ;
    schema:description "Minotauro de piel negra como la lava enfriada que guarda el Ojo de Basalto en su laberinto." ;
    rpg:inspiredBy wd:Q129866 ;
    rpg:vitalStatus rpg:vital-alive ;
    rpg:locatedIn :laberinto-toro ;
    rpg:possesses :ojo-basalto ;
    dnd:statBlock dnd:monster-minotaur ;
    dnd:hitPointMax 95 ;
    dnd:damageResistance dnd:dmg-fire .

:tarasca-mareas a rpg:NonPlayerCharacter , dnd:Creature ;
    rdfs:label "La Tarasca de las Mareas" ;
    schema:description "Leyenda de los pescadores: un coloso acorazado duerme bajo el estrecho y despertará si el dragón vuelve a reinar." ;
    rpg:inspiredBy wd:Q1063874 ;
    rpg:vitalStatus rpg:vital-unknown ;
    dnd:statBlock dnd:monster-tarrasque .

