#################################################################
# Lugares
#################################################################

:costa-ceniza a rpg:Place ;
    rdfs:label "La Costa de Ceniza" ;
    schema:description "Litoral volcánico de salinas, puertos y fortalezas, frente a un archipiélago de lava." .

:puerto-brasa a dnd:Settlement ;
    rdfs:label "Puerto Brasa" ;
    schema:description "Ciudad portuaria amurallada que vive del comercio de la sal. Sede de la Cofradía." ;
    rpg:locatedIn :costa-ceniza ;
    rpg:correspondsTo wd:Q15682 ;
    dnd:population 18000 ;
    rpg:appearsInSession :sesion-01 , :sesion-02 , :sesion-03 .

:taberna-ancla-tiznada a rpg:Place ;
    rdfs:label "Taberna del Ancla Tiznada" ;
    schema:description "Taberna de los muelles, oscura y llena de humo, donde se cierran tratos y se reclutan espadas." ;
    rpg:locatedIn :puerto-brasa ;
    rpg:appearsInSession :sesion-01 , :sesion-03 .

:templo-llama-serena a rpg:Place ;
    rdfs:label "Templo de la Llama Serena" ;
    schema:description "Santuario de una llama que lleva siglos encendida; sus monjes vigilan la montaña." ;
    rpg:locatedIn :puerto-brasa .

:alcazaba-gibra a rpg:Place ;
    rdfs:label "Alcazaba de Gibra" ;
    schema:description "Fortaleza sobre un cerro que domina la bahía; residencia de la alcaidesa." ;
    rpg:locatedIn :costa-ceniza ;
    rpg:correspondsTo wd:Q1049197 ;
    rpg:appearsInSession :sesion-03 .

:islas-ceniza a rpg:Place ;
    rdfs:label "Islas de Ceniza" ;
    schema:description "Archipiélago de malpaíses y conos volcánicos; pocas aldeas, muchos naufragios." ;
    rpg:locatedIn :costa-ceniza ;
    rpg:correspondsTo wd:Q182432 ;
    rpg:appearsInSession :sesion-01 .

:campos-malpais a rpg:Place ;
    rdfs:label "Campos de Malpaís" ;
    schema:description "Mar de lava petrificada cruzado por la ruta de la sal; guarida de los Colmillos de Basalto." ;
    rpg:locatedIn :islas-ceniza ;
    rpg:correspondsTo wd:Q1480521 ;
    rpg:appearsInSession :sesion-02 .

:tuneles-verdes a dnd:Dungeon ;
    rdfs:label "Túneles Verdes" ;
    schema:description "Red de tubos volcánicos de paredes verdosas; refugio de contrabandistas y algo peor en lo más hondo." ;
    rpg:locatedIn :islas-ceniza ;
    rpg:correspondsTo wd:Q899513 ;
    dnd:recommendedLevel 3 ;
    rpg:appearsInSession :sesion-01 .

:laberinto-toro a dnd:Dungeon ;
    rdfs:label "Laberinto del Toro de Basalto" ;
    schema:description "Galerías que cambian de forma con cada temblor, excavadas bajo los Túneles Verdes." ;
    rpg:locatedIn :tuneles-verdes ;
    rpg:inspiredBy wd:Q129866 ;
    dnd:recommendedLevel 5 .

:montana-fuego-dormido a rpg:Place ;
    rdfs:label "Montaña del Fuego Dormido" ;
    schema:description "Volcán solitario en su propia isla, frente a la costa. Lleva veinte años en calma… hasta ahora." ;
    rpg:locatedIn :costa-ceniza ;
    rpg:correspondsTo wd:Q38954 ;
    rpg:appearsInSession :sesion-03 .

#################################################################
# Facciones
#################################################################

:cofradia-sal a rpg:Faction ;
    rdfs:label "Cofradía de la Sal" ;
    schema:description "Gremio de salineros y armadores que gobierna de hecho Puerto Brasa." ;
    rpg:locatedIn :puerto-brasa ;
    rpg:appearsInSession :sesion-01 , :sesion-02 .

:colmillos-basalto a rpg:Faction ;
    rdfs:label "Colmillos de Basalto" ;
    schema:description "Banda de salteadores de las islas, mezcla de semiorcos, trasgos y desertores." ;
    rpg:locatedIn :campos-malpais ;
    rpg:appearsInSession :sesion-02 .

:orden-llama-serena a rpg:Faction ;
    rdfs:label "Orden de la Llama Serena" ;
    schema:description "Orden clerical que custodia la llama eterna y las profecías sobre la montaña." ;
    rpg:locatedIn :templo-llama-serena .

:gaviotas-negras a rpg:Faction ;
    rdfs:label "Gaviotas Negras" ;
    schema:description "Grupo de aventureros rival, más famoso que competente, que trabaja para el mejor postor." ;
    rpg:locatedIn :taberna-ancla-tiznada ;
    rpg:appearsInSession :sesion-02 .

#################################################################
# Objetos
#################################################################

:espada-salitre a dnd:Weapon ;
    rdfs:label "Espada larga «Salitre»" ;
    schema:description "Espada de abordaje con la empuñadura incrustada de sal; nunca se oxida." ;
    dnd:weaponCategory dnd:weapon-martial-melee ;
    dnd:damageDice "1d8" ; dnd:damageType dnd:dmg-slashing ;
    dnd:weight 3.0 ; dnd:costGp 15.0 .

:cota-malla-tome a dnd:Armor ;
    rdfs:label "Cota de malla de Tomé" ;
    schema:description "Cota heredada de su abuelo, con el símbolo de la llama grabado en el pecho." ;
    dnd:armorCategory dnd:armor-heavy ; dnd:baseArmorClass 16 ;
    dnd:weight 55.0 ; dnd:costGp 75.0 .

:escudo-tome a dnd:Armor ;
    rdfs:label "Escudo de la Llama" ;
    schema:description "Escudo de roble con el borde de bronce." ;
    dnd:armorCategory dnd:armor-shield ; dnd:baseArmorClass 2 ;
    dnd:weight 6.0 ; dnd:costGp 10.0 .

:baston-ascuas a dnd:MagicItem ;
    rdfs:label "Bastón de ascuas" ;
    schema:description "Bastón de madera petrificada cuya punta brilla como un carbón. Recuperado de los Túneles Verdes." ;
    dnd:rarity dnd:rarity-uncommon ; dnd:requiresAttunement true ;
    rpg:appearsInSession :sesion-01 .

:ojo-basalto a dnd:MagicItem ;
    rdfs:label "El Ojo de Basalto" ;
    schema:description "Gema negra que late con calor propio. Dicen que quien la posea podrá ordenar a la dragona… o despertarla del todo." ;
    rpg:locatedIn :laberinto-toro ;
    dnd:rarity dnd:rarity-artifact ; dnd:requiresAttunement true .

:carta-corso a rpg:Item ;
    rdfs:label "Carta de corso de la Cofradía" ;
    schema:description "Documento sellado que autoriza a Iria a perseguir a los salteadores en nombre de la Cofradía." ;
    rpg:appearsInSession :sesion-01 .

#################################################################
# Eventos
#################################################################

:erupcion-fuego-dormido a rpg:Event ;
    rdfs:label "La Gran Erupción" ;
    schema:description "La montaña escupió fuego durante nueve días y la dragona se retiró a dormir en su cráter." ;
    rpg:occursIn :montana-fuego-dormido ;
    rpg:inWorldDateLabel "Año 1187 del Sello de Sal" .

:naufragio-pez-plata a rpg:Event ;
    rdfs:label "Naufragio del Pez Plata" ;
    schema:description "Una ola de ceniza caliente hizo encallar al Pez Plata frente a las Islas de Ceniza." ;
    rpg:occursIn :islas-ceniza ;
    rpg:inWorldDateLabel "3 de Brumal de 1207" ;
    rpg:appearsInSession :sesion-01 .

:asalto-caravana a rpg:Event ;
    rdfs:label "Asalto a la caravana de sal" ;
    schema:description "Los Colmillos de Basalto emboscaron la caravana de la Cofradía; el grupo la defendió a duras penas." ;
    rpg:occursIn :campos-malpais ;
    rpg:inWorldDateLabel "9 de Brumal de 1207" ;
    rpg:appearsInSession :sesion-02 .

#################################################################
# Tramas
#################################################################

:trama-naufragio a rpg:Plot ;
    rdfs:label "Los supervivientes del Pez Plata" ;
    schema:description "Sobrevivir al naufragio, rescatar la carga y volver a Puerto Brasa." ;
    rpg:plotStatus rpg:plot-resolved ;
    rpg:involves :iria , :tome , :aelis , :nuno , :leonor , :naufragio-pez-plata ;
    rpg:appearsInSession :sesion-01 .

:trama-calcinaria a rpg:Plot ;
    rdfs:label "El despertar de Calcinaria" ;
    schema:description "La dragona despierta y busca vasallos. ¿Quién en la costa ya trabaja para ella?" ;
    rpg:plotStatus rpg:plot-open ;
    rpg:involves :calcinaria , :montana-fuego-dormido , :nuno , :velasca , :anselmo , :tarasca-mareas ;
    rpg:appearsInSession :sesion-03 .

:trama-ojo-basalto a rpg:Plot ;
    rdfs:label "El Ojo de Basalto" ;
    schema:description "Una gema capaz de dominar a la dragona espera en el laberinto del minotauro. Las Gaviotas Negras también la buscan." ;
    rpg:plotStatus rpg:plot-open ;
    rpg:involves :ojo-basalto , :toro-basalto , :laberinto-toro , :sira , :gaviotas-negras , :orban .
