@prefix :       <__CAMPAIGN__/entity/> .
@prefix rpg:    <https://loregraph.example.org/ont/core#> .
@prefix vtm:    <https://rpg-modules.example.net/vtm5/ont#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix wd:     <http://www.wikidata.org/entity/> .

#################################################################
# Noches de Madrid — crónica de ejemplo (contenido original)
#################################################################

# ---------------------------------------------------------------
# Jugadores / Players
# ---------------------------------------------------------------

:marta a rpg:Player ; rdfs:label "Marta" .
:javi  a rpg:Player ; rdfs:label "Javi" .
:sara  a rpg:Player ; rdfs:label "Sara" .
:dani  a rpg:Player ; rdfs:label "Dani" .

# ---------------------------------------------------------------
# Sesiones / Sessions
# ---------------------------------------------------------------

:sesion-1 a rpg:Session ;
    rdfs:label "Sesión 1: El Elíseo de Linares" ;
    rpg:sessionNumber 1 ;
    rpg:sessionDate "2026-09-05"^^xsd:date ;
    rpg:inWorldDateLabel "Noche del 12 de octubre" ;
    rpg:sessionNotes "La coterie es presentada ante el Príncipe Arteaga en el Palacio de Linares. Isabel de Sandoval humilla públicamente a Teo. Un mensajero anuncia que el antiguo Sheriff, Gonzalo Ferrer, sufrió la Muerte Definitiva en el Retiro hace tres meses y nadie ha encontrado al culpable." .

:sesion-2 a rpg:Session ;
    rdfs:label "Sesión 2: Sangre en la Gran Vía" ;
    rpg:sessionNumber 2 ;
    rpg:sessionDate "2026-09-19"^^xsd:date ;
    rpg:inWorldDateLabel "Noche del 15 de octubre" ;
    rpg:sessionNotes "Una redada de la Sociedad de San Lorenzo en un local de la Gran Vía casi expone a Lucía. Teo bebe por primera vez de la sangre de Isabel a cambio de su protección. Isabel y Bruno rompen su relación tras una discusión en el Círculo de Bellas Artes." .

:sesion-3 a rpg:Session ;
    rdfs:label "Sesión 3: La capilla bajo el templo" ;
    rpg:sessionNumber 3 ;
    rpg:sessionDate "2026-10-03"^^xsd:date ;
    rpg:inWorldDateLabel "Noche del 20 de octubre" ;
    rpg:sessionNotes "El regente Benavente recibe a la coterie en la capilla tremere bajo el Templo de Debod. El Sordo habla de un cuaderno perdido. El padre Ignacio Larra identifica a Lucía y la convierte en su objetivo." .

# ---------------------------------------------------------------
# Lugares / Places
# ---------------------------------------------------------------

:madrid a rpg:Place ;
    rdfs:label "Madrid" ;
    schema:description "La ciudad. De noche, un tablero dividido entre la Camarilla, los anarquistas y quienes los cazan." ;
    rpg:correspondsTo wd:Q2807 ;
    schema:latitude 40.4169 ; schema:longitude -3.7033 .

:palacio-linares a rpg:Place ;
    rdfs:label "Palacio de Linares" ;
    schema:description "Elíseo de la ciudad. Sus salones esconden más fantasmas de los que cuentan las leyendas." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q2628455 ;
    vtm:isElysium true ;
    vtm:masqueradeRisk 1 ;
    rpg:appearsInSession :sesion-1 .

:teatro-real a rpg:Place ;
    rdfs:label "Teatro Real" ;
    schema:description "Coto de caza de la alta sociedad Toreador durante la temporada de ópera." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q211250 ;
    vtm:huntingQuality 3 ; vtm:masqueradeRisk 2 .

:templo-debod a rpg:Place ;
    rdfs:label "Templo de Debod" ;
    schema:description "Bajo el templo egipcio se oculta la capilla de los Tremere de Madrid." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q1140249 ;
    rpg:appearsInSession :sesion-3 .

:capilla-debod a vtm:Haven ;
    rdfs:label "Capilla tremere de Debod" ;
    schema:description "Salas excavadas bajo el parque del Cuartel de la Montaña. Solo se entra por invitación." ;
    rpg:locatedIn :templo-debod ;
    rpg:appearsInSession :sesion-3 .

:ermita-florida a rpg:Place ;
    rdfs:label "Ermita de San Antonio de la Florida" ;
    schema:description "Bajo los frescos de su cúpula reside el Malkavian conocido como El Sordo." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q3109752 .

:viaducto a rpg:Place ;
    rdfs:label "Viaducto de Segovia" ;
    schema:description "Punto de encuentro de la coterie, por encima del tráfico de la calle de Segovia." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q6160850 .

:circulo-bellas-artes a rpg:Place ;
    rdfs:label "Círculo de Bellas Artes" ;
    schema:description "Salón de la arpía Isabel de Sandoval; aquí se hacen y se deshacen reputaciones." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q41323951 ;
    rpg:appearsInSession :sesion-2 .

:cementerio-almudena a rpg:Place ;
    rdfs:label "Cementerio de la Almudena" ;
    schema:description "Territorio neutral de la familia Monforte, de clan Hecata." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q1053320 ;
    vtm:huntingQuality 0 ; vtm:masqueradeRisk 1 .

:tuneles-chamberi a rpg:Place ;
    rdfs:label "Túneles de la estación fantasma" ;
    schema:description "Galerías abandonadas del metro donde los Nosferatu comercian con secretos." ;
    rpg:locatedIn :madrid ;
    vtm:masqueradeRisk 0 .

:lavapies a vtm:Domain ;
    rdfs:label "Dominio de Lavapiés" ;
    schema:description "Barrio reclamado por los anarquistas de Darío Requena. La Camarilla no entra sin permiso." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q2566034 ;
    vtm:domainHolder :libres-lavapies ;
    vtm:huntingQuality 4 ; vtm:masqueradeRisk 2 .

:malasana a vtm:Domain ;
    rdfs:label "Dominio de Malasaña" ;
    schema:description "Noches de bares y conciertos; dominio disputado tras el pacto de Malasaña." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q2521757 ;
    vtm:domainHolder :isabel-sandoval ;
    vtm:huntingQuality 4 ; vtm:masqueradeRisk 3 .

:gran-via a vtm:Domain ;
    rdfs:label "Dominio de la Gran Vía" ;
    schema:description "Escaparate de la ciudad y coto del Príncipe. Desde la redada, vigilado por cazadores." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q1324163 ;
    vtm:domainHolder :fermin-arteaga ;
    vtm:huntingQuality 3 ; vtm:masqueradeRisk 4 ;
    rpg:appearsInSession :sesion-2 .

:retiro a vtm:Domain ;
    rdfs:label "Dominio del Retiro" ;
    schema:description "Parque sin titular desde la muerte del Sheriff Ferrer. De noche, nadie caza allí." ;
    rpg:locatedIn :madrid ;
    rpg:correspondsTo wd:Q1131807 ;
    vtm:huntingQuality 2 ; vtm:masqueradeRisk 3 .

:refugio-lucia a vtm:Haven ;
    rdfs:label "Ático de la calle del Pez" ;
    schema:description "Refugio de Lucía: un ático con las ventanas tapiadas en Malasaña." ;
    rpg:locatedIn :malasana .

# ---------------------------------------------------------------
# Facciones / Factions
# ---------------------------------------------------------------

:camarilla-madrid a rpg:Faction ;
    rdfs:label "Camarilla de Madrid" ;
    schema:description "La corte del Príncipe Arteaga: orden, etiqueta y la Mascarada por encima de todo." ;
    vtm:sect vtm:sect-camarilla ;
    rpg:locatedIn :palacio-linares .

:capilla-tremere a rpg:Faction ;
    rdfs:label "Capilla Tremere de Madrid" ;
    schema:description "Los brujos de la sangre de la ciudad, leales al Príncipe… mientras les convenga." ;
    rpg:memberOf :camarilla-madrid ;
    vtm:sect vtm:sect-camarilla ;
    rpg:locatedIn :capilla-debod .

:libres-lavapies a rpg:Faction ;
    rdfs:label "Los Libres de Lavapiés" ;
    schema:description "Baronía anarquista que rechaza la autoridad del Príncipe." ;
    vtm:sect vtm:sect-anarch ;
    rpg:locatedIn :lavapies .

:cuadrilla-viaducto a vtm:Coterie ;
    rdfs:label "La Cuadrilla del Viaducto" ;
    schema:description "La coterie de los personajes: neonatos de lealtades dudosas al servicio del Príncipe." ;
    rpg:locatedIn :viaducto .

:sociedad-san-lorenzo a rpg:Faction ;
    rdfs:label "Sociedad de San Lorenzo" ;
    schema:description "Hermandad mortal de cazadores con contactos en la Iglesia y la policía." .

:familia-monforte a rpg:Faction ;
    rdfs:label "Familia Monforte" ;
    schema:description "Familia Hecata que custodia el cementerio y comercia con los muertos." ;
    vtm:sect vtm:sect-independent ;
    rpg:locatedIn :cementerio-almudena .

# ---------------------------------------------------------------
# Personajes jugadores / Player characters
# ---------------------------------------------------------------

:lucia-vega a rpg:PlayerCharacter , vtm:Vampire ;
    rdfs:label "Lucía Vega" ;
    schema:description "Antigua sindicalista abrazada por Darío Requena. Furia contenida y lealtades divididas." ;
    rpg:playedBy :marta ;
    rpg:vitalStatus rpg:vital-alive ;
    rpg:locatedIn :malasana ;
    rpg:memberOf :cuadrilla-viaducto ;
    vtm:clan vtm:clan-brujah ;
    vtm:sire :dario-requena ;
    vtm:embraceYear 2019 ; vtm:apparentAge 31 ;
    vtm:bloodPotency 1 ; vtm:hunger 2 ; vtm:humanity 7 ; vtm:willpower 5 ;
    vtm:predatorType vtm:predator-alleycat ;
    vtm:sect vtm:sect-anarch ;
    vtm:haven :refugio-lucia ;
    vtm:ambition "Que nadie vuelva a decidir por los de abajo, ni vivos ni muertos." ;
    vtm:desire "Averiguar quién mató a Ferrer antes que la Camarilla." ;
    vtm:hasDisciplineRating :lucia-vega\/n\/d1 , :lucia-vega\/n\/d2 , :lucia-vega\/n\/d3 ;
    vtm:hasConviction :lucia-vega\/n\/c1 ;
    vtm:hasBoon :lucia-vega\/n\/b1 ;
    rpg:hasRelationship :lucia-vega\/n\/r1 ;
    rpg:appearsInSession :sesion-1 , :sesion-2 , :sesion-3 .

