:trama-ferrer a rpg:Plot ;
    rdfs:label "¿Quién destruyó a Gonzalo Ferrer?" ;
    schema:description "El Príncipe quiere un culpable; los anarquistas, que no sea uno de los suyos." ;
    rpg:plotStatus rpg:plot-open ;
    rpg:involves :gonzalo-ferrer , :bruno-calvo , :ignacio-larra , :muerte-ferrer , :retiro ;
    rpg:appearsInSession :sesion-1 , :sesion-2 , :sesion-3 .

:trama-cuaderno a rpg:Plot ;
    rdfs:label "El cuaderno perdido del Sordo" ;
    schema:description "El Sordo pide recuperar su cuaderno antes de que lo encuentre la capilla Tremere." ;
    rpg:plotStatus rpg:plot-open ;
    rpg:involves :el-sordo , :cuaderno-sordo , :aurelio-benavente , :teo-almagro ;
    rpg:appearsInSession :sesion-3 .

:trama-pacto-malasana a rpg:Plot ;
    rdfs:label "El pacto de Malasaña" ;
    schema:description "Antiguo acuerdo entre Isabel y Darío por el reparto de Malasaña. Se cerró antes de la crónica." ;
    rpg:plotStatus rpg:plot-resolved ;
    rpg:involves :isabel-sandoval , :dario-requena , :malasana .
