:presentacion-principe a rpg:Event ;
    rdfs:label "Presentación ante el Príncipe" ;
    schema:description "La coterie es presentada en el Elíseo y recibe el encargo de investigar la muerte de Ferrer." ;
    rpg:occursIn :palacio-linares ;
    rpg:inWorldDateLabel "12 de octubre" ;
    rpg:appearsInSession :sesion-1 .

:muerte-ferrer a rpg:Event ;
    rdfs:label "Muerte Definitiva de Gonzalo Ferrer" ;
    schema:description "El Sheriff fue destruido junto al estanque del Retiro. Solo quedaron cenizas y una estaca de fresno." ;
    rpg:occursIn :retiro ;
    rpg:inWorldDateLabel "Julio, tres meses antes" .

:redada-gran-via a rpg:Event ;
    rdfs:label "Redada en la Gran Vía" ;
    schema:description "La Sociedad de San Lorenzo irrumpe en un club donde cazaba Lucía." ;
    rpg:occursIn :gran-via ;
    rpg:inWorldDateLabel "15 de octubre" ;
    rpg:appearsInSession :sesion-2 .

