# Copia este archivo como .env y ajusta lo que necesites.
# Los ajustes del modelo de lenguaje, tu nombre, Wikidata y SPARQL también se pueden
# cambiar en la página «Ajustes» de la interfaz; esos valores se guardan en
# data/aux.sqlite y tienen prioridad sobre los de este archivo.
# Todas las variables del backend llevan el prefijo LOREGRAPH_.

# --- Rutas (relativas a la raíz del repositorio) ---
# Almacén RDF (pyoxigraph/RocksDB), índice de búsqueda y caché.
LOREGRAPH_DATA_DIR=data
# Carpeta de módulos de juego.
LOREGRAPH_MODULES_DIR=modules

# --- Identificadores ---
# IRI base provisional. Las entidades de campaña se acuñan bajo <base>/data/.
# Cambiarla con datos existentes obliga a migrar: decide antes de usarlo en serio.
LOREGRAPH_BASE_IRI=https://loregraph.example.org/
# Nombre con el que se registran tus cambios en la procedencia (PROV-O).
LOREGRAPH_USER_NAME=dm

# --- Servidor ---
LOREGRAPH_API_HOST=127.0.0.1
LOREGRAPH_API_PORT=8765
# Puerto del servidor de desarrollo del frontend (Vite).
LOREGRAPH_FRONTEND_PORT=5173
# Orígenes permitidos por CORS (JSON). Solo hace falta si no usas el proxy de Vite.
LOREGRAPH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOREGRAPH_DEFAULT_LANGUAGE=es

# --- SPARQL ---
# Límite máximo de resultados y tiempo máximo (segundos) por consulta.
LOREGRAPH_SPARQL_MAX_RESULTS=1000
LOREGRAPH_SPARQL_TIMEOUT_S=20

# --- Federación con el mundo real ---
LOREGRAPH_FEDERATION_ENABLED=true
LOREGRAPH_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
LOREGRAPH_DBPEDIA_ENDPOINT=https://dbpedia.org/sparql
# Otros endpoints permitidos en SERVICE (JSON). Por seguridad, solo los listados.
LOREGRAPH_FEDERATION_EXTRA_ENDPOINTS=[]
LOREGRAPH_FEDERATION_TIMEOUT_S=15
# Caché de respuestas remotas (segundos). 604800 = una semana.
LOREGRAPH_FEDERATION_CACHE_TTL_S=604800
# Wikidata exige un User-Agent con URL o correo de contacto (si no, responde 403).
# Pon el tuyo: "MiCampaña/1.0 (https://tu-web.example; tu@correo.example)".
LOREGRAPH_FEDERATION_USER_AGENT=LoreGraph/0.1.0 (https://loregraph.example.org/; contacto@loregraph.example.org)

# --- Asistente interno (PydanticAI, modelos locales) ---
# Proveedor: "ollama" u "openai" (cualquier servidor compatible: LM Studio, llama.cpp, vLLM…).
LOREGRAPH_LLM_PROVIDER=ollama
# Ollama: http://localhost:11434/v1 · LM Studio: http://localhost:1234/v1
LOREGRAPH_LLM_BASE_URL=http://localhost:11434/v1
LOREGRAPH_LLM_MODEL=qwen3:8b
# Clave de API (solo para servicios que la pidan).
LOREGRAPH_LLM_API_KEY=
# Ventana de contexto del modelo: ajusta el tamaño de las respuestas de las herramientas.
LOREGRAPH_LLM_CONTEXT_TOKENS=8192
LOREGRAPH_LLM_TIMEOUT_S=120
# Reintentos cuando el modelo propone datos que no superan la validación.
LOREGRAPH_LLM_MAX_RETRIES=3
# Salida estructurada del generador: tool | native | prompted (prueba otra si tu modelo local falla)
LOREGRAPH_LLM_OUTPUT_MODE=tool
