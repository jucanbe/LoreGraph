rdfs:label rdfs:label "nombre"@es , "name"@en .
skos:altLabel rdfs:label "alias"@es , "aliases"@en .
schema:description rdfs:label "descripción"@es , "description"@en .
foaf:depiction rdfs:label "imagen"@es , "depiction"@en .
schema:latitude rdfs:label "latitud"@es , "latitude"@en .
schema:longitude rdfs:label "longitud"@es , "longitude"@en .
rdf:type rdfs:label "tipo"@es , "type"@en .
